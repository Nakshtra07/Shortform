DEEPGRAM_API_KEY=your_deepgram_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
GROQ_API_KEY=

# Advisory VLM (NVIDIA Nemotron 3 Nano Omni).
# NOTE: the VLM is an INFORMATION SOURCE only. It never influences
# boundaries, payoff, pacing, framing, captions, or Render QA, and a
# missing/invalid key only degrades advisory scoring -- clips still render.
NVIDIA_API_KEY=
# Optional override; defaults to nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# AUTOSHORTS_VLM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# AUTOSHORTS_VLM_SCORING=1

# REZE Window Scoring (NVIDIA NIM DiffusionGemma)
# Strictly opt-in: requires all 3 (DISCOVERY_MODE=window_scoring, REZE_PROVIDER=nvidia_diffusiongemma, NVIDIA_API_KEY).
# If any is missing, silently falls back to default DeepSeek Chat timestamp generation.
# AUTOSHORTS_DISCOVERY_MODE=window_scoring
# AUTOSHORTS_REZE_PROVIDER=nvidia_diffusiongemma
# NVIDIA_REZE_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_REZE_MODEL=google/diffusiongemma-26b-a4b-it

# AutoClip Holistic Scoring Backend (Top-N candidate selection)
# AUTOSHORTS_SCORING_BACKEND selects the authoritative candidate-score source:
#   legacy   (default) — composite_score stays authoritative; no NVIDIA key required.
#   autoclip           — NVIDIA NIM holistic final_score is authoritative;
#                        requires NVIDIA_API_KEY (hard error if missing).
# No silent fallback occurs between backends. The UI scoring-mode selector
# (import dialog + per-project select) passes an explicit per-call override
# that takes precedence over this env default for that operation only.
# See docs/development/AUTOCLIP_SCORING_BACKEND.md for the full contract.
# AUTOSHORTS_SCORING_BACKEND=autoclip
# Scorer model override (default: nvidia/nemotron-3-ultra-550b-a55b)
# AUTOSHORTS_SCORER_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Scorer endpoint base override (default: https://integrate.api.nvidia.com/v1)
# NVIDIA_SCORER_BASE_URL=https://integrate.api.nvidia.com/v1
# Reasoning toggle (default off) and output cap (default 4096)
# AUTOSHORTS_SCORER_THINKING=0
# AUTOSHORTS_SCORER_MAX_TOKENS=4096
# Eligibility threshold for AutoClip mode (default 0.65, inclusive >=)
# AUTOCLIP_RECOMMEND_THRESHOLD=0.65
# Top-N selection limit (default 12; <= 0 disables the cutoff = all eligible)
# AUTOSHORTS_TOP_N=12

